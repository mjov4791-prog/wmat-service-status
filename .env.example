# Copy to .env.local. Never commit .env.local to git.
# In Vercel, set these in Project Settings → Environment Variables.
#
# Reuses the same Supabase backend as the other CyberApache AI Solutions projects
# (WMAT Navigator, FILN, Tribal Continuity Navigator). The schema for this
# project uses table names prefixed with `wss_` (WMAT Service Status) so it
# does not collide with the other projects' tables.

SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
